# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB Atlas persistence.
# If omitted, WealthFarm runs on the robust local JSON-backed storage engine.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/wealthfarm?retryWrites=true&w=majority"

# AUTH_SECRET: Cryptographic secret for signing session authorization tokens.
AUTH_SECRET="wealthfarm_production_auth_hmac_secret_key"

# PAYSTACK_SECRET_KEY: Secret key from your Paystack dashboard (sk_test_... or sk_live_...).
# Never exposed in client code. Used for server-side initialization & transaction verification.
PAYSTACK_SECRET_KEY="sk_test_wealthfarm_paystack_secret"

# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY: Public key for client Paystack inline forms.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_wealthfarm_paystack_public"
